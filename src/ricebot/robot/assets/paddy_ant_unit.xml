<mujoco model="paddy_ant_homogeneous_unit">
  <option timestep="0.004" gravity="0 0 -9.81" integrator="implicitfast"/>
  <statistic center="0.10 -0.05 0.10" extent="0.45"/>
  <asset>
    <material name="wheel_rubber_mat" rgba="0.16 0.16 0.18 1"/>
  </asset>
  <worldbody>
    <light name="sun" pos="0.5 -0.5 2.0" dir="0 0 -1"/>
    <geom name="field_ground" type="plane" size="2 2 0.1" rgba="0.34 0.27 0.19 1" contype="1" conaffinity="7" friction="1.4 0.01 0.005"/>
    
    <!-- ========================================================================= -->
    <!-- HOMOGENEOUS SWARM UNIT: PLANTER (Work + Sensor + Rigid Dock/Lock Rescue) -->
    <!-- ========================================================================= -->
    <body name="planter_body" pos="0.100 -0.050 0.068">
      <freejoint name="planter_free"/>
      <!-- Sealed IP68 Waterproof Hull (270 x 190 x 64 mm, outer wheel width 276 mm < 300 mm row) -->
      <geom name="planter_chassis" type="box" pos="0 0 0.015" size="0.135 0.095 0.032" mass="2.6" contype="2" conaffinity="5" rgba="0.16 0.46 0.86 1"/>
      <!-- Top Electronics Deck & BeiDou RTK Mast -->
      <geom name="planter_deck" type="box" pos="-0.02 0 0.055" size="0.080 0.070 0.012" mass="0.15" contype="0" conaffinity="0" rgba="0.92 0.94 0.96 1"/>
      <geom name="planter_rtk_mast" type="cylinder" pos="-0.075 0.048 0.095" size="0.008 0.035" mass="0.02" contype="0" conaffinity="0" rgba="0.85 0.85 0.85 1"/>
      <geom name="planter_rtk_dome" type="sphere" pos="-0.075 0.048 0.135" size="0.018" mass="0.01" contype="0" conaffinity="0" rgba="0.96 0.96 0.98 1"/>
      <!-- Soil Moisture / Firmness Probe Mast (present on every homogeneous unit) -->
      <geom name="planter_probe_boom" type="cylinder" pos="-0.075 -0.048 0.088" size="0.010 0.028" mass="0.02" contype="0" conaffinity="0" rgba="0.25 0.85 0.92 1"/>
      <!-- Seed Hopper Funnel & Bottom Drop Chute (present on every homogeneous unit) -->
      <geom name="planter_hopper_outer" type="cylinder" pos="0.025 0 0.075" size="0.040 0.026" mass="0.10" contype="0" conaffinity="0" rgba="0.95 0.76 0.14 1"/>
      <geom name="planter_hopper_inner" type="cylinder" pos="0.025 0 0.102" size="0.030 0.004" mass="0.01" contype="0" conaffinity="0" rgba="0.22 0.22 0.24 1"/>

      <!-- Front LiDAR / Rangefinder Turret (3-ray fan: center, +18 deg left, -18 deg right) -->
      <geom name="planter_lidar_pod" type="cylinder" pos="0.112 0 0.055" size="0.020 0.013" mass="0.02" contype="0" conaffinity="0" rgba="0.18 0.18 0.20 1"/>
      <site name="planter_range_c" pos="0.140 0.00 0.048" zaxis="1 0 0" size="0.008" rgba="1 0.2 0.2 1"/>
      <site name="planter_range_l" pos="0.138 0.04 0.048" zaxis="0.951 0.309 0" size="0.006" rgba="1 0.2 0.2 1"/>
      <site name="planter_range_r" pos="0.138 -0.04 0.048" zaxis="0.951 -0.309 0" size="0.006" rgba="1 0.2 0.2 1"/>
      <site name="planter_odom_site" pos="0 0 0" size="0.01" rgba="1 1 1 1"/>

      <!-- COMBINED RIGID DOCKING & CAM-LOCKING RESCUE MECHANISM (FRONT ACTIVE CONE + LATCH) -->
      <body name="planter_dock_boom" pos="0.135 0 0.012">
        <!-- Active pitch-lift joint: pries a docked stuck peer upward (+Z) to break mud suction -->
        <joint name="planter_dock_pitch" type="hinge" axis="0 -1 0" range="-0.20 0.45" damping="2.5" armature="0.005"/>
        <geom name="planter_dock_shank" type="box" pos="0.022 0 0" size="0.022 0.018 0.009" mass="0.01" contype="0" conaffinity="0" rgba="0.82 0.85 0.90 1"/>
        <geom name="planter_dock_cone" type="cylinder" pos="0.048 0 0" zaxis="1 0 0" size="0.016 0.014" mass="0.01" contype="0" conaffinity="0" rgba="0.95 0.42 0.18 1"/>
        <site name="planter_front_dock_site" pos="0.058 0 0" size="0.010" rgba="1 0.3 0.1 1"/>
        <!-- Rotary Cam-Locking Jaw inside the Docking Cone (grabs peer's rear strike bar rigidly) -->
        <body name="planter_latch_jaw" pos="0.048 0 0.010">
          <joint name="planter_latch_j" type="hinge" axis="0 1 0" range="0.0 0.65" damping="0.8" armature="0.002"/>
          <geom name="planter_latch_hook" type="box" pos="0.012 0 -0.008" size="0.014 0.010 0.006" mass="0.005" contype="0" conaffinity="0" rgba="0.98 0.22 0.22 1"/>
        </body>
      </body>

      <!-- REAR PASSIVE ALIGNMENT FUNNEL & RIGID STRIKE BAR (Matches peer's Front Docking Cone) -->
      <geom name="planter_rear_funnel_l" type="box" pos="-0.150 0.024 0.012" euler="0 0 -0.35" size="0.018 0.005 0.014" mass="0.005" contype="0" conaffinity="0" rgba="0.75 0.78 0.82 1"/>
      <geom name="planter_rear_funnel_r" type="box" pos="-0.150 -0.024 0.012" euler="0 0 0.35" size="0.018 0.005 0.014" mass="0.005" contype="0" conaffinity="0" rgba="0.75 0.78 0.82 1"/>
      <geom name="planter_rear_strike_bar" type="cylinder" pos="-0.148 0 0.012" zaxis="0 1 0" size="0.006 0.020" mass="0.005" contype="0" conaffinity="0" rgba="0.95 0.75 0.15 1"/>
      <site name="planter_rear_dock_site" pos="-0.148 0 0.012" size="0.010" rgba="0.95 0.85 0.15 1"/>

      <!-- REAR DEPLOYABLE HARDPAN ANCHOR SPADES (Reaction anchor during heavy pry/pull) -->
      <body name="planter_spade_arm" pos="-0.132 0 -0.005">
        <joint name="planter_spade_j" type="hinge" axis="0 1 0" range="0.0 0.85" damping="1.2" armature="0.003"/>
        <geom name="planter_spade_l" type="box" pos="-0.028 0.055 -0.018" euler="0 0.55 0" size="0.026 0.008 0.004" mass="0.005" contype="0" conaffinity="0" rgba="0.88 0.22 0.22 1"/>
        <geom name="planter_spade_r" type="box" pos="-0.028 -0.055 -0.018" euler="0 0.55 0" size="0.026 0.008 0.004" mass="0.005" contype="0" conaffinity="0" rgba="0.88 0.22 0.22 1"/>
      </body>

      <!-- 4 Revolute Paddy Wheels (radius=0.058m, half-width=0.020m, outer width=276mm) -->
      <body name="planter_wheel_fl" pos="0.085 0.118 0.0">
        <joint name="planter_j_fl" type="hinge" axis="0 1 0" damping="0.08" armature="0.005"/>
        <geom name="planter_w_fl" type="cylinder" size="0.058 0.020" zaxis="0 1 0" mass="0.35" material="wheel_rubber_mat" contype="2" conaffinity="1" friction="1.4 0.01 0.005"/>
        <geom name="planter_hub_fl" type="box" pos="0 0.021 0" size="0.038 0.002 0.010" contype="0" conaffinity="0" rgba="0.90 0.75 0.15 1"/>
      </body>
      <body name="planter_wheel_fr" pos="0.085 -0.118 0.0">
        <joint name="planter_j_fr" type="hinge" axis="0 1 0" damping="0.08" armature="0.005"/>
        <geom name="planter_w_fr" type="cylinder" size="0.058 0.020" zaxis="0 1 0" mass="0.35" material="wheel_rubber_mat" contype="2" conaffinity="1" friction="1.4 0.01 0.005"/>
        <geom name="planter_hub_fr" type="box" pos="0 -0.021 0" size="0.038 0.002 0.010" contype="0" conaffinity="0" rgba="0.90 0.75 0.15 1"/>
      </body>
      <body name="planter_wheel_rl" pos="-0.085 0.118 0.0">
        <joint name="planter_j_rl" type="hinge" axis="0 1 0" damping="0.08" armature="0.005"/>
        <geom name="planter_w_rl" type="cylinder" size="0.058 0.020" zaxis="0 1 0" mass="0.35" material="wheel_rubber_mat" contype="2" conaffinity="1" friction="1.4 0.01 0.005"/>
        <geom name="planter_hub_rl" type="box" pos="0 0.021 0" size="0.038 0.002 0.010" contype="0" conaffinity="0" rgba="0.90 0.75 0.15 1"/>
      </body>
      <body name="planter_wheel_rr" pos="-0.085 -0.118 0.0">
        <joint name="planter_j_rr" type="hinge" axis="0 1 0" damping="0.08" armature="0.005"/>
        <geom name="planter_w_rr" type="cylinder" size="0.058 0.020" zaxis="0 1 0" mass="0.35" material="wheel_rubber_mat" contype="2" conaffinity="1" friction="1.4 0.01 0.005"/>
        <geom name="planter_hub_rr" type="box" pos="0 -0.021 0" size="0.038 0.002 0.010" contype="0" conaffinity="0" rgba="0.90 0.75 0.15 1"/>
      </body>
    </body>

  </worldbody>
  <actuator>
    <velocity name="planter_act_fl" joint="planter_j_fl" kv="1.2" ctrllimited="true" ctrlrange="-14.0 14.0"/>
    <velocity name="planter_act_fr" joint="planter_j_fr" kv="1.2" ctrllimited="true" ctrlrange="-14.0 14.0"/>
    <velocity name="planter_act_rl" joint="planter_j_rl" kv="1.2" ctrllimited="true" ctrlrange="-14.0 14.0"/>
    <velocity name="planter_act_rr" joint="planter_j_rr" kv="1.2" ctrllimited="true" ctrlrange="-14.0 14.0"/>
    <position name="planter_dock_pitch_act" joint="planter_dock_pitch" kp="35.0" ctrllimited="true" ctrlrange="-0.20 0.45"/>
    <position name="planter_latch_act" joint="planter_latch_j" kp="15.0" ctrllimited="true" ctrlrange="0.0 0.65"/>
    <position name="planter_spade_act" joint="planter_spade_j" kp="20.0" ctrllimited="true" ctrlrange="0.0 0.85"/>
  </actuator>
  <sensor>
    <rangefinder name="planter_range_c" site="planter_range_c"/>
    <rangefinder name="planter_range_l" site="planter_range_l"/>
    <rangefinder name="planter_range_r" site="planter_range_r"/>
    <framepos name="planter_pos" objtype="site" objname="planter_odom_site"/>
    <framequat name="planter_quat" objtype="site" objname="planter_odom_site"/>
    <framepos name="planter_front_dock_pos" objtype="site" objname="planter_front_dock_site"/>
    <framepos name="planter_rear_dock_pos" objtype="site" objname="planter_rear_dock_site"/>
  </sensor>
</mujoco>
